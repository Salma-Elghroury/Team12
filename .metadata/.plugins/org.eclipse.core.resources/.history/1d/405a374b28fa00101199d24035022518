	public void setUpMarble(int playerIndex, int marbleIndex, Marble marble){
		MarbleView marbleView = new MarbleView(marble);
		marbleView.setTranslateX(cellPositions.get(2+(2*playerIndex))[marbleIndex]-8);
		marbleView.setTranslateY(cellPositions.get(3+(2*playerIndex))[marbleIndex]-8);
		marbles.get(playerIndex).add(marbleView);
	}
	
	public void startRound(Game game, AnchorPane root){
		for (int i=0; i<4; i++)
			for (int j=0; j<4; j++){
				CardView temp = new CardView(game.getPlayers().get(i).getHand().get(j));
				temp.setTranslateX(deckXPosition-8);
				temp.setTranslateY(deckYPosition-8);
				root.getChildren().add(temp);
				hands.get(i).add(temp);
				translateCardFromDeck(i,temp,j);
			}
		turnOn();
		PauseTransition pause = new PauseTransition(Duration.seconds(2.6));
		pause.play();
		pause.setOnFinished(E -> {
			for (int i=0; i<4; i++)
				flipCard(playerHand.get(i));
		});
	}
	
	private boolean empty(){
		if (!playerHand.isEmpty() || !cpu1Hand.isEmpty() || !cpu2Hand.isEmpty() || !cpu3Hand.isEmpty()){
			for (int i=0; i<4; i++){
				while (!hands.get(i).isEmpty()){
					translateCardToFirepit(hands.get(i).get(0),i);
					hands.get(i).remove(0);
				}
			}
			return true;
		}
		return false;
	}
	
	public void turnOn(){
		for (int i=0; i<playerHand.size() ;i++)
			playerHand.get(i).turnOn();
		for (int i=0; i<4; i++){
			playerMarbles.get(i).turnOn();
			cpu1Marbles.get(i).turnOn();
			cpu2Marbles.get(i).turnOn();
			cpu3Marbles.get(i).turnOn();
		}
	}
	
	public void turnOff(){
		for (int i=0; i<playerHand.size() ;i++)
			playerHand.get(i).turnOff();
		for (int i=0; i<4; i++){
			playerMarbles.get(i).turnOff();
			cpu1Marbles.get(i).turnOff();
			cpu2Marbles.get(i).turnOff();
			cpu3Marbles.get(i).turnOff();
		}
	}
	
	public void translateCardFromDeck(int playerIndex, CardView card, int cardIndex){
		double x = 0, y = 0, angle = 0;
		switch (playerIndex){
		case 0: x = playerHandXPosition[cardIndex]-3; y = playerHandYPosition[cardIndex]-8; break;
		case 1: x = cpu1HandXPosition[cardIndex]+25; y = cpu1HandYPosition[cardIndex]-33; angle = 90; break;
		case 2: x = cpu2HandXPosition[cardIndex]-3; y = cpu2HandYPosition[cardIndex]-8; break;
		case 3: x = cpu3HandXPosition[cardIndex]+25; y = cpu3HandYPosition[cardIndex]-33; angle = -90; break;
		default: break;
		}
		TranslateTransition translate = new TranslateTransition();
		translate.setDelay(Duration.seconds(1));
		translate.setToX(x);
		translate.setToY(y);
		translate.setDuration(Duration.seconds(1));
		RotateTransition rotate = new RotateTransition();
		rotate.setToAngle(angle);
		rotate.setDuration(Duration.seconds(0.5));
		SequentialTransition animation = new SequentialTransition(card, translate, rotate);
		animation.play();
	}
	
	public void translateCardToFirepit(CardView card, int playerIndex){
		TranslateTransition translate = new TranslateTransition();
		translate.setDuration(Duration.seconds(1));
		translate.setToX(firePitXPosition-8);
		translate.setToY(firePitYPosition-8);
		RotateTransition rotate = new RotateTransition();
		rotate.setToAngle(0);
		rotate.setDuration(Duration.seconds(0.5));
		SequentialTransition animation = new SequentialTransition(card, translate, rotate);
		animation.play();
		firepit = card;
	}
	
	public void flipCard(CardView image){
		image.frontCard(image.getCard());
	}
	
