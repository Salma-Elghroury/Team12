    private void createTrackCells() {
        // Create 100 track cells
        for (int i = 0; i < 100; i++) {
            Circle cell = new Circle(
                trackXPositions[i], 
                trackYPositions[i], 
                MARBLE_RADIUS
            );
            
            // Set cell color as specified
            cell.setFill(Color.web("#f1d0a5"));
            cell.setStroke(Color.BLACK);
            cell.setStrokeWidth(1);
            
            // Add to board elements
            boardElements.getChildren().add(cell);
            
            // Optional: Add cell number label for debugging
            Label cellNumber = new Label(String.valueOf(i));
            cellNumber.setLayoutX(trackXPositions[i] - 5);
            cellNumber.setLayoutY(trackYPositions[i] - 5);
            cellNumber.setStyle("-fx-font-size: 8px;");
            boardElements.getChildren().add(cellNumber);
        }
    }
    
