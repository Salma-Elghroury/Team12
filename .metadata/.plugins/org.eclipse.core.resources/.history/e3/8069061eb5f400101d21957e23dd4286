    private void placeHomeZoneMarbles() {
        ArrayList<Player> players = game.getPlayers();
        
        // Place marbles for each player based on their color order
        for (int i = 0; i < players.size(); i++) {
            Player player = players.get(i);
            Colour colour = player.getColour();
            
            // Determine which home zone positions to use based on player index
            double[] homeXPositions;
            double[] homeYPositions;
            
            switch (i) {
                case 0:
                    homeXPositions = homeZone1XPositions;
                    homeYPositions = homeZone1YPositions;
                    break;
                case 1:
                    homeXPositions = homeZone2XPositions;
                    homeYPositions = homeZone2YPositions;
                    break;
                case 2:
                    homeXPositions = homeZone3XPositions;
                    homeYPositions = homeZone3YPositions;
                    break;
                case 3:
                    homeXPositions = homeZone4XPositions;
                    homeYPositions = homeZone4YPositions;
                    break;
                default:
                    continue;
            }
            
            // Create 4 marbles for this player
            for (int j = 0; j < 4; j++) {
                Circle marble = new Circle(
                    homeXPositions[j], 
                    homeYPositions[j], 
                    MARBLE_RADIUS
                );
                
                // Set marble color based on player's colour
                switch (colour) {
                    case RED:
                        marble.setFill(Color.RED);
                        break;
                    case GREEN:
                        marble.setFill(Color.GREEN);
                        break;
                    case BLUE:
                        marble.setFill(Color.BLUE);
                        break;
                    case YELLOW:
                        marble.setFill(Color.YELLOW);
                        break;
                }
                
                marble.setStroke(Color.BLACK);
                marble.setStrokeWidth(1);
                
                // Add marble ID for reference
                marble.setId("marble_" + colour + "_" + j);
                
                boardElements.getChildren().add(marble);
            }
        }
    }
    
    private void placeCards() {
        ArrayList<Player> players = game.getPlayers();
        
        // Create fire pit card placeholder
        Rectangle firePitCard = new Rectangle(
            firePitXPosition, 
            firePitYPosition, 
            CARD_WIDTH, 
            CARD_HEIGHT
        );
        firePitCard.setFill(Color.LIGHTGRAY);
        firePitCard.setStroke(Color.BLACK);
        firePitCard.setStrokeWidth(1);
        firePitCard.setId("firePit");
        boardElements.getChildren().add(firePitCard);
        
        // Create deck card placeholder
        Rectangle deckCard = new Rectangle(
            deckXPosition, 
            deckYPosition, 
            CARD_WIDTH, 
            CARD_HEIGHT
        );
        deckCard.setFill(Color.LIGHTGRAY);
        deckCard.setStroke(Color.BLACK);
        deckCard.setStrokeWidth(1);
        deckCard.setId("deck");
        boardElements.getChildren().add(deckCard);
        
        // Place cards for each player's hand
        for (int i = 0; i < players.size(); i++) {
            Player player = players.get(i);
            ArrayList<Card> hand = player.getHand();
            
            // Determine which hand positions to use based on player index
            double[] handXPositions;
            double[] handYPositions;
            
            switch (i) {
                case 0: // Human player
                    handXPositions = playerHandXPosition;
                    handYPositions = playerHandYPosition;
                    break;
                case 1: // CPU 1
                    handXPositions = cpu1HandXPosition;
                    handYPositions = cpu1HandYPosition;
                    break;
                case 2: // CPU 2
                    handXPositions = cpu2HandXPosition;
                    handYPositions = cpu2HandYPosition;
                    break;
                case 3: // CPU 3
                    handXPositions = cpu3HandXPosition;
                    handYPositions = cpu3HandYPosition;
                    break;
                default:
                    continue;
            }
            
            // Create placeholder cards for each card in hand
            for (int j = 0; j < hand.size() && j < 4; j++) {
                Rectangle card = new Rectangle(
                    handXPositions[j], 
                    handYPositions[j], 
                    CARD_WIDTH, 
                    CARD_HEIGHT
                );
                
                // Set card color - you can customize this later
                card.setFill(Color.WHITE);
                card.setStroke(Color.BLACK);
                card.setStrokeWidth(1);
                
                // Add card information label
                Label cardLabel = new Label(hand.get(j).getName());
                cardLabel.setLayoutX(handXPositions[j] + 10);
                cardLabel.setLayoutY(handYPositions[j] + 10);
                cardLabel.setStyle("-fx-font-size: 12px;");
                
                // Add card ID for reference
                card.setId("card_" + player.getColour() + "_" + j);
                
                boardElements.getChildren().addAll(card, cardLabel);
            }
        }
    }
    
