package stage;

import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.image.Image;
import javafx.scene.layout.Background;
import javafx.scene.layout.BackgroundImage;
import javafx.scene.layout.BackgroundPosition;
import javafx.scene.layout.BackgroundRepeat;
import javafx.scene.layout.BackgroundSize;
import javafx.scene.layout.VBox;
import javafx.scene.text.Font;
import javafx.stage.Stage;
import model.Colour;

public class WinStage{
	
	String imageName;
	int width;
	int height;

	public WinStage(String playerName, Colour colour, int winnerIndex){
		setBackgroundInfo(winnerIndex);
		Stage stage = new Stage();
		stage.setResizable(false);
		VBox root = new VBox(5);
		
		// background
     	Image image = new Image(imageName);
     	BackgroundImage bgIm = new BackgroundImage(image,
     			BackgroundRepeat.NO_REPEAT, BackgroundRepeat.NO_REPEAT,
     			BackgroundPosition.CENTER, new BackgroundSize(width, height, true,
     					true, true, true));
     	Background bg = new Background(bgIm);
     	root.setBackground(bg);
		root.setPrefSize(width, height);
		root.setAlignment(Pos.CENTER);
		
		Label label = new Label("Winner: " + playerName+"\nColour: "+getColorName(colour));
		label.setFont(new Font("Times New Roman", 25));
		label.setWrapText(true);
		label.setStyle("-fx-text-fill: white;");
		Button button = new Button("Exit");
		button.setFont(new Font("Times New Roman", 20));
		button.setStyle("-fx-text-fill: white; -fx-background-color: "+getColorName(colour)+";");
		root.getChildren().addAll(label, button);
		Scene scene = new Scene(root, width, height);
		stage.setScene(scene);
		stage.show();
		button.setOnMouseClicked(E -> {
			stage.close();
		});
	}
	
	private void setBackgroundInfo(int playerIndex){
		imageName = "/game/";
		switch (playerIndex){
		case 1:
			imageName += "Wizard.png";
			width = 736;
			height = 910;
			break;
		case 2:
			imageName += "Dragon.png";
			width = 2136;
			height = 1200;
			break;
		case 3:
			imageName += "Pixie.png";
			width = 512;
			height = 512;
			break;
		default:
			imageName += "Player.png";
			width = 736;
			height = 710;
			break;
		}
	}
	
	private String getColorName(Colour colour){
		switch (colour){
		case RED: return "Red";
		case YELLOW: return "Yellow";
		case BLUE: return "Blue";
		default: return "Green";
		}
	}

}
